<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
<uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.D424softwareengineeringcapstonee"
        tools:targetApi="31">

        <receiver android:name=".activities.NotificationReceiver"
            android:enabled="true"
            android:exported="false"/>

        <activity
            android:name=".activities.ConfDetails"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:exported="false" />
        <activity
            android:name=".activities.TripDetails"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:exported="false" />
        <activity android:name=".activities.SearchActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:exported="false"/>
        <activity android:name=".activities.ReportActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:exported="false"/>
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            tools:ignore="DuplicateActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.MainActivity"
            android:exported="false"/>
        <activity android:name=".activities.HomeActivity"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:exported="false"/>
    </application>

</manifest>